{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "Microsoft.AspNetCore": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30,
                    "fileSizeLimitBytes": 10485760,
                    "rollOnFileSizeLimit": true,
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] [{MachineName}] [{ProcessId}] [{ThreadId}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithProcessId",
            "WithThreadId"
        ],
        "Properties": {
            "Application": "YourAppName",
            "Environment": "Development"
        }
    },
    "Devices": {
        "ModbusTcp": [
            {
                "DeviceName": "数字量输入板",
                "Ip": "192.168.1.105",
                "Port": 502,
                "SlaveId": 1,
                "PollInterval": 1000
            },
            {
                "DeviceName": "数字量输出板",
                "Ip": "192.168.1.151",
                "Port": 502,
                "SlaveId": 1,
                "PollInterval": 1000
            }
        ],
        "ModbusRtu": [
            {
                "Port": "COM3",
                "BaudRate": 19200,
                "DataBits": 8,
                "Parity": "None",
                "StopBits": 2,
                "Slaves": [
                    {
                        "MainController": {
                            "DeviceName": "主控制器",
                            "SlaveId": 1,
                            "PollInterval": 1000
                        }
                    },
                    {
                        "DcVoltmeter": {
                            "DeviceName": "直流电压表",
                            "SlaveId": 2,
                            "PollInterval": 1000
                        }
                    },
                    {
                        "AcVoltmeter": {
                            "DeviceName": "交流电压表",
                            "SlaveId": 3,
                            "PollInterval": 1000
                        }
                    }
                ]
            }
        ],
        "Target": {
            "Ip": "192.168.1.100",
            "Port": 9000
        }
    }
}